# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# SQLite file. In production point this to a persistent disk, e.g. /data/greenleaf.db
DATABASE_PATH=./data/greenleaf.db
# Server-side only. Leave empty to run without AI (assistant falls back to offline help).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only change for tests or a proxy.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Set to true when running behind a reverse proxy (Render, Railway, Fly, nginx).
TRUST_PROXY=false
